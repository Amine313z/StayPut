# Headers of the static files (Workers static assets). The Worker's own routes (/api, /webhooks,
# /health…) set theirs in apps/worker/src/http.ts.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'

# Vite fingerprints these file names: they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
